# Application Settings
APP_NAME="Executive AI Voice Agent"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Defaults to zero-setup local SQLite)
# For SQLite: sqlite+aiosqlite:///./executive_agent.db
# For PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/voice_agent_db
DATABASE_URL=sqlite+aiosqlite:///./executive_agent.db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Neural Voice Configuration (Edge-TTS)
# Examples: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
DEFAULT_VOICE=en-US-AriaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz
